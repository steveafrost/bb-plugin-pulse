{
  "name": "bb-plugin-thirdhand",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "description": "A live board of what needs you, mirrored from Third Hand on the iPhone: the app captures, this plugin renders the snapshot and queues your actions back to it.",
  "repository": {
    "type": "git",
    "url": "https://github.com/steveafrost/bb-plugin-thirdhand.git"
  },
  "license": "MIT",
  "bin": {
    "thirdhand": "./bin/thirdhand.mjs"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs && node --experimental-strip-types --import ./test/resolve-ts.mjs --test test/*.test.ts"
  },
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Third Hand",
    "description": "A live board of what needs you, mirrored from Third Hand on the iPhone: the app captures, this plugin renders the snapshot and queues your actions back to it.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
